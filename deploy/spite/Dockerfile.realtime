FROM node:22-bookworm-slim AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production HOST=0.0.0.0 PORT=3007
RUN corepack enable

COPY nexoclip-app/services/spite/package.json nexoclip-app/services/spite/pnpm-lock.yaml nexoclip-app/services/spite/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod=false
COPY --chown=node:node nexoclip-app/services/spite/tsconfig.json nexoclip-app/services/spite/next.config.mjs ./
COPY --chown=node:node nexoclip-app/services/spite/lib ./lib
COPY --chown=node:node nexoclip-app/services/spite/realtime ./realtime
COPY --chown=node:node nexoclip-app/services/spite/scripts ./scripts
COPY --chown=node:node nexoclip-app/services/spite/database-setup.sql ./database-setup.sql

USER node
EXPOSE 3007
CMD ["pnpm", "realtime"]
